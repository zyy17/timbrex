# Copy to .env, then uncomment and fill only the settings you need.
# Timbrex does not load .env automatically. See docs/configuration.md.
# Use shell-quoted values; source only a trusted file you have reviewed.
# Never commit secrets or paste them into chat. No settings are enabled here.

# Common overrides (optional). Leave unset to preserve YAML and built-in defaults.
# Selecting a real provider for synthesis can incur charges; stub is offline.
# TIMBREX_PROVIDER=''
# TIMBREX_STRICT_TAGS=''

# OpenAI
# OPENAI_API_KEY=''
# OPENAI_MODEL=''
# OPENAI_VOICE=''
# OPENAI_BASE_URL=''

# ElevenLabs (also select a voice here, in the script, or with --voice)
# ELEVENLABS_API_KEY=''
# ELEVENLABS_VOICE_ID=''
# ELEVENLABS_MODEL=''
# ELEVENLABS_BASE_URL=''

# MiniMax
# MINIMAX_API_KEY=''
# MINIMAX_MODEL=''
# MINIMAX_VOICE_ID=''
# MINIMAX_BASE_URL=''

# Azure Speech (set a region or full endpoint URL; endpoint takes priority)
# AZURE_SPEECH_KEY=''
# AZURE_SPEECH_REGION=''
# AZURE_SPEECH_ENDPOINT=''
# AZURE_SPEECH_VOICE=''

# Qwen (requires a full workspace endpoint URL; see docs/providers.md)
# DASHSCOPE_API_KEY=''
# QWEN_ENDPOINT=''
# QWEN_MODEL=''
# QWEN_VOICE=''

# Gemini TTS
# GEMINI_API_KEY=''
# GEMINI_MODEL=''
# GEMINI_VOICE=''
# GEMINI_BASE_URL=''

# Fish Audio (also select a voice here, in the script, or with --voice)
# FISH_API_KEY=''
# FISH_VOICE_ID=''
# FISH_MODEL=''
# FISH_BASE_URL=''
